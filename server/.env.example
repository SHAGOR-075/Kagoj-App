PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/kagoj_notes?retryWrites=true&w=majority
CLIENT_URL=https://your-frontend.vercel.app

# WebAuthn Configuration
# On Vercel: Set RP_ID to your frontend domain (e.g. kagoj-client.vercel.app - no https://, no port)
# Set ORIGIN to your full frontend URL (e.g. https://kagoj-client.vercel.app)
RP_ID=localhost
RP_NAME=Kagoj Quick Notes
ORIGIN=http://localhost:3000

# Security Secrets (generate random 32+ character strings)
JWT_SECRET=generate-a-random-jwt-secret-string-min-32-chars
OTP_SECRET=generate-a-random-otp-secret-string-min-32-chars
# 32 random bytes base64 encoded: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NOTES_MASTER_KEY=generate-32-bytes-base64-master-encryption-key
MONGODB_URI_TEST=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/kagoj_notes_test?retryWrites=true&w=majority

# Gmail SMTP Configuration (for sending verification OTP emails)
# Generate via: Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password
